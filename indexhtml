  // Chart 4 — Pie: paper by unit
  const unitTotals = UNITS.map(u => appPaper.reduce((s,p)=>s+(p.units[u]||0),0));

  chartInstances.pie2 = new Chart(document.getElementById('chartPie2'), {
    type: 'pie',
