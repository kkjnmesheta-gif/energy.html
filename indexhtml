let appPaper = loaded.paper;

/* ════════════════════════════════════════════════
   HELPERS
════════════════════════════════════════════════ */
function fmtRM(v) {
  return 'RM ' + Number(v).toLocaleString('ms-MY', {minimumFractionDigits:2, maximumFractionDigits:2});
}
function showAlert(msg, isErr=false) {
  const t = document.getElementById('alert-toast');
  t.textContent = msg;
  t.style.background = isErr ? '#dc2626' : '#064e3b';
  t.style.display = 'block';
  setTimeout(() => t.style.display='none', 3000);
}
function togglePanel(id) {
  document.getElementById(id).classList.toggle('open');
}
function resetData() {
  if (!confirm('Reset semua data ke data simulasi asal? Semua kemaskini akan hilang.')) return;
  localStorage.removeItem(LS_BILLS);
  localStorage.removeItem(LS_PAPER);
  location.reload();
}

/* ════════════════════════════════════════════════
   TAB NAVIGATION
════════════════════════════════════════════════ */
function showView(viewId, btn) {
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('view-' + viewId).classList.add('active');
  if (btn) btn.classList.add('active');
  if (viewId === 'overview') renderOverview();
  if (viewId === 'graf')     renderCharts();
  if (viewId === 'rekod')    { renderBillsTable(); renderPaperTable(); populateBilForm(); }
}

/* ════════════════════════════════════════════════
   TAB 1 — OVERVIEW
════════════════════════════════════════════════ */
function renderOverview() {
  const last = appBills.length - 1;
  const cur  = appBills[last];
  const prev = appBills[last > 0 ? last - 1 : 0];

  function trendHTML(curVal, prevVal) {
    if (curVal === prevVal) return `<span class="trend-eq">— Tiada Perubahan</span>`;
    const pct = (((curVal - prevVal) / prevVal) * 100).toFixed(1);
    if (curVal > prevVal)
      return `<span class="trend-up">↑ +${pct}% vs ${prev.month}</span>`;
    return `<span class="trend-down">↓ ${pct}% vs ${prev.month}</span>`;
  }

  const curJumlah  = cur.elektrik + cur.air + cur.kertas;
  const prevJumlah = prev.elektrik + prev.air + prev.kertas;

  document.getElementById('summary-cards').innerHTML = `
    <div class="sum-card" style="background:var(--grad-elektrik)">
      <div class="card-icon">💡</div>
      <div class="card-label">Bil Elektrik</div>
      <div class="card-value">${fmtRM(cur.elektrik)}</div>
      <div class="card-trend">${trendHTML(cur.elektrik, prev.elektrik)}</div>
      <div class="card-sub">${cur.month} 2026</div>
    </div>
    <div class="sum-card" style="background:var(--grad-air)">
      <div class="card-icon">💧</div>
      <div class="card-label">Bil Air</div>
      <div class="card-value">${fmtRM(cur.air)}</div>
      <div class="card-trend">${trendHTML(cur.air, prev.air)}</div>
      <div class="card-sub">${cur.month} 2026</div>
    </div>
    <div class="sum-card" style="background:var(--grad-kertas)">
      <div class="card-icon">📄</div>
      <div class="card-label">Kos Kertas</div>
      <div class="card-value">${fmtRM(cur.kertas)}</div>
      <div class="card-trend">${trendHTML(cur.kertas, prev.kertas)}</div>
      <div class="card-sub">${cur.month} 2026</div>
    </div>
    <div class="sum-card" style="background:var(--grad-jumlah)">
      <div class="card-icon">💰</div>
      <div class="card-label">Jumlah Keseluruhan</div>
      <div class="card-value">${fmtRM(curJumlah)}</div>
      <div class="card-trend">${trendHTML(curJumlah, prevJumlah)}</div>
      <div class="card-sub">${cur.month} 2026</div>
    </div>
  `;

  // YTD sums
  let ytdE=0, ytdA=0, ytdK=0;
  appBills.forEach(b => { ytdE+=b.elektrik; ytdA+=b.air; ytdK+=b.kertas; });
  const ytdTotal = ytdE + ytdA + ytdK;

  document.getElementById('ytd-row').innerHTML = `
    <div class="kpi-card e"><div class="kpi-value">${fmtRM(ytdE)}</div><div class="kpi-label">⚡ YTD Elektrik</div></div>
    <div class="kpi-card a"><div class="kpi-value">${fmtRM(ytdA)}</div><div class="kpi-label">💧 YTD Air</div></div>
    <div class="kpi-card k"><div class="kpi-value">${fmtRM(ytdK)}</div><div class="kpi-label">📄 YTD Kertas</div></div>
    <div class="kpi-card t"><div class="kpi-value">${fmtRM(ytdTotal)}</div><div class="kpi-label">💰 YTD Keseluruhan</div></div>
  `;

  // Highlights
  const maxE = appBills.reduce((a,b) => b.elektrik>a.elektrik?b:a);
  const maxA = appBills.reduce((a,b) => b.air>a.air?b:a);

  // top paper unit
  const unitTotals = {};
  UNITS.forEach(u => unitTotals[u] = 0);
  appPaper.forEach(p => UNITS.forEach(u => unitTotals[u] += p.units[u]||0));
  const topUnit = Object.entries(unitTotals).sort((a,b) => b[1]-a[1])[0];

  // avg monthly elektrik
  const avgE = (ytdE / appBills.length).toFixed(0);

  document.getElementById('highlight-row').innerHTML = `
    <div class="kpi-card e">
      <div class="kpi-value">${maxE.month}</div>
      <div class="kpi-label">🔺 Bulan Tertinggi Elektrik (${fmtRM(maxE.elektrik)})</div>
    </div>
    <div class="kpi-card a">
      <div class="kpi-value">${maxA.month}</div>
      <div class="kpi-label">🔺 Bulan Tertinggi Air (${fmtRM(maxA.air)})</div>
    </div>
    <div class="kpi-card k">
      <div class="kpi-value">${topUnit[0]}</div>
      <div class="kpi-label">📄 Unit Paling Banyak Mohon Kertas (${topUnit[1]} rim)</div>
    </div>
    <div class="kpi-card t">
      <div class="kpi-value">${fmtRM(avgE)}</div>
      <div class="kpi-label">📊 Purata Bil Elektrik Bulanan</div>
    </div>
  `;
}

/* ════════════════════════════════════════════════
   TAB 2 — CHARTS
════════════════════════════════════════════════ */
let chartInstances = {};

function destroyCharts() {
  Object.values(chartInstances).forEach(c => { if(c) c.destroy(); });
  chartInstances = {};
}

const UNIT_COLORS = [
  '#6366f1','#10b981','#f59e0b','#3b82f6','#ef4444',
  '#8b5cf6','#06b6d4','#f97316','#84cc16','#ec4899','#14b8a6'
];

function renderCharts() {
  destroyCharts();

  const labels   = appBills.map(b => b.month.substring(0,3));
  const elektrik = appBills.map(b => b.elektrik);
  const air      = appBills.map(b => b.air);
  const kertas   = appBills.map(b => b.kertas);

  // Chart 1 — Line
  chartInstances.line = new Chart(document.getElementById('chartLine'), {
    type: 'line',
    data: {
      labels,
      datasets: [
        { label:'Elektrik', data:elektrik, borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,.1)', tension:.4, fill:true, pointRadius:4 },
        { label:'Air',      data:air,      borderColor:'#3b82f6', backgroundColor:'rgba(59,130,246,.1)', tension:.4, fill:true, pointRadius:4 },
        { label:'Kertas',   data:kertas,   borderColor:'#10b981', backgroundColor:'rgba(16,185,129,.1)', tension:.4, fill:true, pointRadius:4 },
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ position:'bottom' } },
      scales:{
        y:{ beginAtZero:false, ticks:{ callback: v=>'RM '+v.toLocaleString() } }
      }
    }
  });

  // Chart 2 — Bar
  chartInstances.bar = new Chart(document.getElementById('chartBar'), {
    type: 'bar',
    data: {
      labels,
      datasets: [
        { label:'Elektrik', data:elektrik, backgroundColor:'rgba(245,158,11,.8)' },
        { label:'Air',      data:air,      backgroundColor:'rgba(59,130,246,.8)' },
        { label:'Kertas',   data:kertas,   backgroundColor:'rgba(16,185,129,.8)' },
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ position:'bottom' } },
      scales:{
        y:{ beginAtZero:true, ticks:{ callback: v=>'RM '+v.toLocaleString() } }
      }
    }
  });

  // Chart 3 — Pie: cost distribution
  const ytdE = elektrik.reduce((a,b)=>a+b,0);
  const ytdA = air.reduce((a,b)=>a+b,0);
  const ytdK = kertas.reduce((a,b)=>a+b,0);

  chartInstances.pie1 = new Chart(document.getElementById('chartPie1'), {
    type: 'doughnut',
    data: {
      labels: ['Elektrik','Air','Kertas'],
      datasets: [{
        data: [ytdE, ytdA, ytdK],
