<!DOCTYPE html>
<html lang="ms">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Pengurusan Tenaga & Kertas | KK Jempol 2026</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    /* ── Design Tokens ─────────────────────────────── */
    :root {
      --bg:            #f0fdf9;
      --surface:       #ffffff;
      --border:        #d1fae5;
      --text:          #064e3b;
      --muted:         #6b7280;
      --grad-header:   linear-gradient(135deg, #064e3b 0%, #1d4ed8 100%);
      --grad-elektrik: linear-gradient(135deg, #f59e0b, #d97706);
      --grad-air:      linear-gradient(135deg, #0284c7, #0ea5e9);
      --grad-kertas:   linear-gradient(135deg, #10b981, #059669);
      --grad-jumlah:   linear-gradient(135deg, #6366f1, #4f46e5);
      --c-elektrik:    #f59e0b;
      --c-air:         #3b82f6;
      --c-kertas:      #10b981;
      --c-jumlah:      #6366f1;
      --radius:        12px;
      --radius-sm:     8px;
      --shadow:        0 2px 8px rgba(0,0,0,.07), 0 4px 20px rgba(0,0,0,.05);
      --shadow-hover:  0 8px 24px rgba(0,0,0,.13), 0 16px 40px rgba(0,0,0,.08);
      --gap:           1.25rem;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px;
      line-height: 1.6;
      background: var(--bg);
      color: #1f2937;
      min-height: 100vh;
    }

    /* ── Header ────────────────────────────────────── */
    header {
      background: var(--grad-header);
      padding: 0 2rem;
      height: 72px;
      display: flex;
      align-items: center;
      gap: 1rem;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 2px 20px rgba(6,78,59,.45);
    }
    .hdr-logo  { font-size: 2rem; line-height: 1; }
    .hdr-text  { flex: 1; }
    .hdr-inst  { font-size: 0.7rem; font-weight: 500; color: rgba(255,255,255,.65); text-transform: uppercase; letter-spacing: 0.1em; }
    .hdr-title { font-size: 1.1rem; font-weight: 800; color: #fff; letter-spacing: -.01em; }
    .hdr-badge {
      background: rgba(255,255,255,.18);
      color: #fff;
      font-size: 0.78rem;
      font-weight: 700;
      padding: .3rem .9rem;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,.3);
    }
    .hdr-prepared {
      text-align: right;
      line-height: 1.35;
      margin-left: 1rem;
    }
    .hdr-prepared-label {
      font-size: 0.65rem;
      color: rgba(255,255,255,.6);
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }
    .hdr-prepared-name {
      font-size: 0.8rem;
      font-weight: 700;
      color: #ffffff;
    }
    .hdr-prepared-role {
      font-size: 0.65rem;
      color: rgba(255,255,255,.7);
    }

    /* ── Tab Nav ───────────────────────────────────── */
    .tab-nav {
      background: #fff;
      border-bottom: 2px solid var(--border);
      display: flex;
      padding: 0 2rem;
    }
    .tab-btn {
      padding: .85rem 1.5rem;
      font-size: .88rem;
      font-weight: 600;
      color: var(--muted);
      background: none;
      border: none;
      border-bottom: 3px solid transparent;
      margin-bottom: -2px;
      cursor: pointer;
      transition: color .15s, border-color .15s;
      font-family: inherit;
    }
    .tab-btn:hover { color: var(--c-kertas); }
    .tab-btn.active { color: var(--c-kertas); border-bottom-color: var(--c-kertas); }

    /* ── Main ──────────────────────────────────────── */
    main { max-width: 1200px; margin: 0 auto; padding: 1.75rem 1.5rem 3rem; }
    .view { display: none; }
    .view.active { display: block; }
    .section-label {
      font-size: .72rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .1em; color: var(--c-kertas); margin-bottom: .9rem;
    }

    /* ── Summary Cards ─────────────────────────────── */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: var(--gap);
      margin-bottom: 2rem;
    }
    .sum-card {
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.5rem 1.5rem 1.3rem;
      color: #fff;
      display: flex; flex-direction: column; gap: .35rem;
      transition: transform .2s, box-shadow .2s;
      cursor: default;
    }
    .sum-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-hover); }
    .card-icon  { font-size: 1.8rem; line-height: 1; margin-bottom: .1rem; }
    .card-label { font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; opacity: .85; }
    .card-value { font-size: 2rem; font-weight: 800; line-height: 1.1; letter-spacing: -.02em; }
    .card-trend { font-size: .78rem; font-weight: 600; display: flex; align-items: center; gap: .3rem; margin-top: .2rem; }
    .trend-up   { color: #fca5a5; }
    .trend-down { color: #a7f3d0; }
    .trend-eq   { color: rgba(255,255,255,.7); }
    .chg-up     { color: #dc2626; font-weight: 600; font-size: .8rem; }
    .chg-down   { color: #16a34a; font-weight: 600; font-size: .8rem; }
    .chg-eq     { color: #9ca3af; font-size: .8rem; }
    .card-sub   { font-size: .75rem; opacity: .72; margin-top: .1rem; }

    /* ── KPI Rows ──────────────────────────────────── */
    .kpi-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: var(--gap);
      margin-bottom: 1.5rem;
    }
    .kpi-card {
      background: var(--surface);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1rem 1.25rem;
      border-left: 4px solid var(--c-kertas);
    }
    .kpi-card.e { border-left-color: var(--c-elektrik); }
    .kpi-card.a { border-left-color: var(--c-air); }
    .kpi-card.k { border-left-color: var(--c-kertas); }
    .kpi-card.t { border-left-color: var(--c-jumlah); }
    .kpi-value  { font-size: 1.4rem; font-weight: 800; color: #064e3b; }
    .kpi-label  { font-size: .72rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin-top: .25rem; }

    /* ── Chart Grid ────────────────────────────────── */
    .chart-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(480px, 1fr));
      gap: var(--gap);
    }
    .chart-card {
      background: var(--surface);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 1.25rem 1.5rem 1.5rem;
    }
    .chart-title {
      font-size: .85rem; font-weight: 700; color: var(--text);
      margin-bottom: 1rem; display: flex; align-items: center; gap: .5rem;
    }
    .chart-wrap { position: relative; height: 280px; }

    /* ── Tables ────────────────────────────────────── */
    .rekod-section { margin-bottom: 2.5rem; }
    .rekod-section h3 { font-size: .95rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; display: flex; align-items: center; gap: .5rem; }
    .table-wrap { background: var(--surface); border-radius: var(--radius); box-shadow: var(--shadow); overflow-x: auto; margin-bottom: 1.25rem; }
    table { width: 100%; border-collapse: collapse; font-size: .8rem; }
    thead tr { background: #f0fdf4; border-bottom: 2px solid var(--border); }
    th { padding: .65rem .85rem; text-align: right; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); white-space: nowrap; }
    th:first-child { text-align: left; }
    td { padding: .6rem .85rem; border-bottom: 1px solid #f3f4f6; color: #1f2937; text-align: right; vertical-align: middle; }
    td:first-child { text-align: left; font-weight: 600; }
    tbody tr:last-child td { border-bottom: none; }
    tbody tr:hover { background: #f0fdf4; }
    .total-row td { font-weight: 700; background: #f0fdf4; color: #064e3b; border-top: 2px solid var(--border); }
    .highlight-row td { background: #ecfdf5 !important; }

    /* ── Forms ─────────────────────────────────────── */
    .form-panel {
      background: var(--surface);
      border: 1.5px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.25rem;
      display: none;
    }
    .form-panel.open { display: block; }
    .form-panel h4 { font-size: .88rem; font-weight: 700; color: var(--text); margin-bottom: 1rem; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: .75rem; margin-bottom: 1rem; }
    .form-field { display: flex; flex-direction: column; gap: .3rem; }
    .form-field label { font-size: .7rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; }
    .form-field input, .form-field select {
      padding: .45rem .75rem; border: 1.5px solid #d1d5db; border-radius: var(--radius-sm);
      font-family: inherit; font-size: .84rem; color: #1f2937; background: #fff; outline: none;
    }
    .form-field input:focus, .form-field select:focus { border-color: var(--c-kertas); }
    .form-actions { display: flex; gap: .5rem; flex-wrap: wrap; }

    /* ── Buttons ───────────────────────────────────── */
    .btn {
      padding: .48rem 1.1rem; border: none; border-radius: var(--radius-sm);
      font-family: inherit; font-size: .84rem; font-weight: 600;
      cursor: pointer; transition: opacity .15s, transform .1s;
    }
    .btn:hover { opacity: .88; }
    .btn:active { transform: scale(.97); }
    .btn-green  { background: var(--c-kertas); color: #fff; }
    .btn-blue   { background: var(--c-air); color: #fff; }
    .btn-grey   { background: #e5e7eb; color: #374151; }
    .btn-red    { background: #ef4444; color: #fff; }
    .toolbar    { display: flex; gap: .75rem; flex-wrap: wrap; margin-bottom: 1.25rem; align-items: center; }

    /* ── Alert Toast ───────────────────────────────── */
    #alert-toast {
      display: none; position: fixed; top: 82px; right: 1.5rem;
      background: #064e3b; color: #fff; padding: .75rem 1.25rem;
      border-radius: var(--radius-sm); font-size: .84rem; font-weight: 500;
      z-index: 999; box-shadow: 0 4px 20px rgba(0,0,0,.2); max-width: 340px;
    }

    /* ── Login Overlay ─────────────────────────────── */
    #login-overlay {
      position: fixed; inset: 0;
      background: linear-gradient(135deg, #064e3b 0%, #1d4ed8 100%);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999;
    }
    #login-box {
      background: #fff; border-radius: 14px;
      padding: 2.5rem 2.2rem; width: 100%; max-width: 380px;
      box-shadow: 0 20px 60px rgba(0,0,0,.35);
      text-align: center;
    }
    #login-box .login-logo { font-size: 2.8rem; margin-bottom: .4rem; }
    #login-box .login-title {
      font-size: 1.1rem; font-weight: 800; color: #064e3b;
      margin-bottom: .2rem; letter-spacing: -.01em;
    }
    #login-box .login-sub {
      font-size: .75rem; color: #6b7280; margin-bottom: 1.8rem;
    }
    #login-box .lf-group {
      text-align: left; margin-bottom: 1rem;
    }
    #login-box .lf-group label {
      display: block; font-size: .72rem; font-weight: 700;
      color: #374151; text-transform: uppercase; letter-spacing: .06em;
      margin-bottom: .35rem;
    }
    #login-box .lf-group input {
      width: 100%; box-sizing: border-box;
      padding: .55rem .85rem; border: 1.5px solid #d1d5db;
      border-radius: 8px; font-family: inherit; font-size: .9rem;
      color: #1f2937; outline: none; transition: border-color .15s;
    }
    #login-box .lf-group input:focus { border-color: #064e3b; }
    #login-btn {
      width: 100%; padding: .65rem; margin-top: .6rem;
      background: linear-gradient(135deg, #064e3b, #1d4ed8);
      color: #fff; border: none; border-radius: 8px;
      font-family: inherit; font-size: .95rem; font-weight: 700;
      cursor: pointer; transition: opacity .15s;
    }
    #login-btn:hover { opacity: .88; }
    #login-error {
      display: none; margin-top: .9rem;
      background: #fef2f2; border: 1px solid #fca5a5;
      color: #b91c1c; border-radius: 7px;
      padding: .5rem .75rem; font-size: .8rem; font-weight: 600;
    }
    #app-wrapper { display: none; }
  </style>
</head>
<body>

<!-- ── Login Overlay ────────────────────────────── -->
<div id="login-overlay">
  <div id="login-box">
    <div class="login-logo">⚡</div>
    <div class="login-title">Dashboard Pengurusan Tenaga &amp; Kertas</div>
    <div class="login-sub">Kolej Komuniti Jempol, Negeri Sembilan · 2026</div>
    <div class="lf-group">
      <label>Nama Pengguna</label>
      <input type="text" id="li-user" placeholder="Username" autocomplete="username" />
    </div>
    <div class="lf-group">
      <label>Kata Laluan</label>
      <input type="password" id="li-pass" placeholder="Password" autocomplete="current-password"
             onkeydown="if(event.key==='Enter') doLogin()" />
    </div>
    <button id="login-btn" onclick="doLogin()">🔐 Log Masuk</button>
    <div id="login-error">❌ Nama pengguna atau kata laluan tidak sah.</div>
  </div>
</div>

<!-- ── App Wrapper (hidden until login) ─────────── -->
<div id="app-wrapper">

<header>
  <div class="hdr-logo">⚡</div>
  <div class="hdr-text">
    <div class="hdr-inst">Kolej Komuniti Jempol, Negeri Sembilan</div>
    <div class="hdr-title">Dashboard Pengurusan Tenaga &amp; Kertas</div>
  </div>
  <div class="hdr-badge">2026</div>
  <div class="hdr-prepared">
    <div class="hdr-prepared-label">Disediakan oleh</div>
    <div class="hdr-prepared-name">Pn. Mesheta binti Mohd Noor</div>
    <div class="hdr-prepared-role">Pengurus Unit SmartGreen</div>
  </div>
</header>

<nav class="tab-nav">
  <button class="tab-btn active" onclick="showView('overview',this)">📊 Overview</button>
  <button class="tab-btn" onclick="showView('graf',this)">📈 Graf &amp; Trend</button>
  <button class="tab-btn" onclick="showView('rekod',this)">📋 Rekod</button>
</nav>

<div id="alert-toast"></div>

<main>

  <!-- ══ TAB 1: OVERVIEW ══ -->
  <div id="view-overview" class="view active">
    <p class="section-label">Ringkasan Bulan Terkini</p>
    <div class="cards-grid" id="summary-cards"></div>
    <p class="section-label">Jumlah Kumulatif Setahun (YTD)</p>
    <div class="kpi-row" id="ytd-row"></div>
    <p class="section-label">Pencapaian Utama</p>
    <div class="kpi-row" id="highlight-row"></div>
  </div>

  <!-- ══ TAB 2: GRAF ══ -->
  <div id="view-graf" class="view">
    <p class="section-label">Visualisasi Data 2026</p>
    <div class="chart-grid">
      <div class="chart-card">
        <div class="chart-title">📈 Trend Bil Bulanan 2026</div>
        <div class="chart-wrap"><canvas id="chartLine"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">📊 Perbandingan Bil Bulanan</div>
        <div class="chart-wrap"><canvas id="chartBar"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">🥧 Agihan Kos Keseluruhan (YTD)</div>
        <div class="chart-wrap"><canvas id="chartPie1"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-title">🥧 Permohonan Kertas ikut Unit (YTD)</div>
        <div class="chart-wrap"><canvas id="chartPie2"></canvas></div>
      </div>
    </div>
  </div>

  <!-- ══ TAB 3: REKOD ══ -->
  <div id="view-rekod" class="view">

    <!-- Bills section -->
    <div class="rekod-section">
      <h3>💡💧📄 Rekod Bil Bulanan</h3>
      <div class="toolbar">
        <button class="btn btn-green" onclick="togglePanel('bil-form')">✏️ Kemaskini Bil</button>
      </div>
      <div class="form-panel" id="bil-form">
        <h4>Kemaskini Bil Bulanan</h4>
        <div class="form-grid">
          <div class="form-field">
            <label>Bulan</label>
            <select id="bf-month" onchange="fillBilForm()"></select>
          </div>
          <div class="form-field">
            <label>Elektrik (RM)</label>
            <input type="number" id="bf-elektrik" min="0" step="0.01" placeholder="0.00" />
          </div>
          <div class="form-field">
            <label>Air (RM)</label>
            <input type="number" id="bf-air" min="0" step="0.01" placeholder="0.00" />
          </div>
          <div class="form-field">
            <label>Kertas (RM)</label>
            <input type="number" id="bf-kertas" min="0" step="0.01" placeholder="0.00" />
          </div>
        </div>
        <div class="form-actions">
          <button class="btn btn-green" onclick="saveBil()">💾 Simpan</button>
          <button class="btn btn-grey" onclick="togglePanel('bil-form')">Batal</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Bulan</th><th>Elektrik (RM)</th><th>% ±</th><th>Air (RM)</th><th>% ±</th>
              <th>Kertas (RM)</th><th>% ±</th><th>Jumlah (RM)</th><th>% ±</th>
            </tr>
          </thead>
          <tbody id="bills-tbody"></tbody>
        </table>
      </div>
    </div>

    <!-- Paper section -->
    <div class="rekod-section">
      <h3>📄 Rekod Permohonan Kertas (Rim) ikut Unit</h3>
      <div class="toolbar">
        <button class="btn btn-blue" onclick="togglePanel('kertas-form')">✏️ Kemaskini Kertas</button>
        <button class="btn btn-red" onclick="resetData()">🔄 Reset ke Data Asal</button>
      </div>
      <div class="form-panel" id="kertas-form">
        <h4>Kemaskini Permohonan Kertas</h4>
        <div class="form-grid" id="kertas-form-grid"></div>
        <div class="form-actions">
          <button class="btn btn-blue" onclick="saveKertas()">💾 Simpan</button>
          <button class="btn btn-grey" onclick="togglePanel('kertas-form')">Batal</button>
        </div>
      </div>
      <div class="table-wrap">
        <table id="paper-table">
          <thead id="paper-thead"></thead>
          <tbody id="paper-tbody"></tbody>
        </table>
      </div>
    </div>

  </div><!-- end view-rekod -->

</main>

<script>
/* ════════════════════════════════════════════════
   CONSTANTS
════════════════════════════════════════════════ */
const MONTHS = ['Januari','Februari','Mac','April','Mei','Jun',
