/* ════════════════════════════════════════════════
   LOCALSTORAGE
════════════════════════════════════════════════ */
function saveData() {
  localStorage.setItem(LS_BILLS, JSON.stringify(appBills));
  localStorage.setItem(LS_PAPER, JSON.stringify(appPaper));
}

function loadData() {
  const b = localStorage.getItem(LS_BILLS);
  const p = localStorage.getItem(LS_PAPER);
  return {
    bills: b ? JSON.parse(b) : JSON.parse(JSON.stringify(DEFAULT_BILLS)),
    paper: p ? JSON.parse(p) : JSON.parse(JSON.stringify(DEFAULT_PAPER))
  };
}

