    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{
        legend:{ position:'bottom', labels:{ font:{ size:10 }, boxWidth:12 } },
        tooltip:{ callbacks:{ label: ctx => ` ${ctx.label}: ${ctx.raw} rim (${(ctx.raw/unitTotals.reduce((a,b)=>a+b,0)*100).toFixed(1)}%)` } }
