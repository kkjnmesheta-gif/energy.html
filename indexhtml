const CREDS = {
  admin: '64d2f4c0f3fc0a971740edfc96bace6c6e70dbb7167efd0b8e889f0b8c5e6d7e'
};
const LS_AUTH = 'energy_auth_2026';

async function sha256(str) {
  const buf = await crypto.subtle.digest('SHA-256',
    new TextEncoder().encode(str));
  return Array.from(new Uint8Array(buf))
    .map(b => b.toString(16).padStart(2,'0')).join('');
}

async function doLogin() {
  const user = document.getElementById('li-user').value.trim().toLowerCase();
  const pass = document.getElementById('li-pass').value;
  const err  = document.getElementById('login-error');
  if (!CREDS[user]) { err.style.display='block'; return; }
  const hash = await sha256(pass);
  if (hash !== CREDS[user]) { err.style.display='block'; return; }
  err.style.display = 'none';
  sessionStorage.setItem(LS_AUTH, '1');
  document.getElementById('login-overlay').style.display = 'none';
  document.getElementById('app-wrapper').style.display   = 'block';
}

// Auto-skip login if already authenticated this session
if (sessionStorage.getItem(LS_AUTH) === '1') {
  document.getElementById('login-overlay').style.display = 'none';
  document.getElementById('app-wrapper').style.display   = 'block';
}
