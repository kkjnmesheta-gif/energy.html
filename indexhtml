/* ════════════════════════════════════════════════
   TAB 3 — REKOD: BILLS TABLE
════════════════════════════════════════════════ */
function pctChange(cur, prev) {
  if (prev === 0) return `<span class="chg-eq">—</span>`;
  const diff = ((cur - prev) / prev * 100).toFixed(1);
  if (diff > 0)  return `<span class="chg-up">↑ +${diff}%</span>`;
  if (diff < 0)  return `<span class="chg-down">↓ ${diff}%</span>`;
  return `<span class="chg-eq">0%</span>`;
}

function renderBillsTable() {
  let ytdE=0, ytdA=0, ytdK=0;
  const rows = appBills.map((b, i) => {
    const total = b.elektrik + b.air + b.kertas;
    ytdE += b.elektrik; ytdA += b.air; ytdK += b.kertas;
    const prev = i > 0 ? appBills[i - 1] : null;
    const prevTotal = prev ? prev.elektrik + prev.air + prev.kertas : 0;
    const ceE = prev ? pctChange(b.elektrik, prev.elektrik) : `<span class="chg-eq">—</span>`;
    const ceA = prev ? pctChange(b.air,      prev.air)      : `<span class="chg-eq">—</span>`;
    const ceK = prev ? pctChange(b.kertas,   prev.kertas)   : `<span class="chg-eq">—</span>`;
    const ceT = prev ? pctChange(total,       prevTotal)    : `<span class="chg-eq">—</span>`;
    return `<tr>
      <td>${b.month}</td>
      <td>${fmtRM(b.elektrik)}</td><td>${ceE}</td>
      <td>${fmtRM(b.air)}</td><td>${ceA}</td>
      <td>${fmtRM(b.kertas)}</td><td>${ceK}</td>
      <td>${fmtRM(total)}</td><td>${ceT}</td>
    </tr>`;
  }).join('');
  const ytdTotal = ytdE + ytdA + ytdK;
  document.getElementById('bills-tbody').innerHTML = rows + `
    <tr class="total-row">
      <td>JUMLAH YTD</td>
      <td>${fmtRM(ytdE)}</td><td>—</td>
      <td>${fmtRM(ytdA)}</td><td>—</td>
      <td>${fmtRM(ytdK)}</td><td>—</td>
      <td>${fmtRM(ytdTotal)}</td><td>—</td>
    </tr>`;
}

/* ════════════════════════════════════════════════
   TAB 3 — REKOD: PAPER TABLE
════════════════════════════════════════════════ */
function renderPaperTable() {
  // Header
  document.getElementById('paper-thead').innerHTML =
    `<tr><th>Bulan</th>${UNITS.map(u=>`<th>${u}</th>`).join('')}<th>Jumlah</th></tr>`;

  // Unit totals row
  const unitYTD = UNITS.map(u => appPaper.reduce((s,p)=>s+(p.units[u]||0),0));

  const rows = appPaper.map(p => {
    const rowTotal = UNITS.reduce((s,u)=>s+(p.units[u]||0),0);
    return `<tr>
      <td>${p.month}</td>
      ${UNITS.map(u=>`<td>${p.units[u]||0}</td>`).join('')}
      <td>${rowTotal}</td>
    </tr>`;
  }).join('');

  const grandTotal = unitYTD.reduce((a,b)=>a+b,0);
  document.getElementById('paper-tbody').innerHTML = rows + `
    <tr class="total-row">
      <td>JUMLAH YTD</td>
      ${unitYTD.map(v=>`<td>${v}</td>`).join('')}
      <td>${grandTotal}</td>
    </tr>`;
}

/* ════════════════════════════════════════════════
   BILL FORM
════════════════════════════════════════════════ */
function populateBilForm() {
  const sel = document.getElementById('bf-month');
  sel.innerHTML = MONTHS.map(m=>`<option value="${m}">${m}</option>`).join('');
  fillBilForm();
}

function fillBilForm() {
  const m = document.getElementById('bf-month').value;
  const rec = appBills.find(b => b.month === m);
  if (rec) {
    document.getElementById('bf-elektrik').value = rec.elektrik;
    document.getElementById('bf-air').value      = rec.air;
    document.getElementById('bf-kertas').value   = rec.kertas;
  }
}

function saveBil() {
  const m = document.getElementById('bf-month').value;
  const e = parseFloat(document.getElementById('bf-elektrik').value);
  const a = parseFloat(document.getElementById('bf-air').value);
  const k = parseFloat(document.getElementById('bf-kertas').value);
  if ([e,a,k].some(v=>isNaN(v)||v<0)) { showAlert('⚠️ Sila masukkan nilai yang sah (nombor positif).', true); return; }
  const rec = appBills.find(b => b.month === m);
  if (rec) { rec.elektrik=e; rec.air=a; rec.kertas=k; }
  saveData();
  renderBillsTable();
  renderOverview();
  showAlert(`✅ Bil ${m} berjaya dikemaskini.`);
}

/* ════════════════════════════════════════════════
   KERTAS FORM
════════════════════════════════════════════════ */
function buildKertasForm() {
  const grid = document.getElementById('kertas-form-grid');
  grid.innerHTML = `
    <div class="form-field">
      <label>Bulan</label>
      <select id="kf-month" onchange="fillKertasForm()">${MONTHS.map(m=>`<option>${m}</option>`).join('')}</select>
    </div>
    ${UNITS.map(u=>`
      <div class="form-field">
        <label>${u} (Rim)</label>
        <input type="number" id="kf-${u}" min="0" step="1" placeholder="0" />
      </div>`).join('')}
  `;
  fillKertasForm();
}

function fillKertasForm() {
  const m = document.getElementById('kf-month').value;
  const rec = appPaper.find(p => p.month === m);
  if (rec) UNITS.forEach(u => { const el=document.getElementById('kf-'+u); if(el) el.value=rec.units[u]||0; });
}

function saveKertas() {
  const m = document.getElementById('kf-month').value;
  const rec = appPaper.find(p => p.month === m);
  if (!rec) return;
  let valid = true;
  UNITS.forEach(u => {
    const v = parseInt(document.getElementById('kf-'+u).value);
    if (isNaN(v)||v<0) { valid=false; return; }
    rec.units[u] = v;
  });
  if (!valid) { showAlert('⚠️ Sila masukkan nilai yang sah.', true); return; }
  saveData();
  renderPaperTable();
  showAlert(`✅ Permohonan kertas ${m} berjaya dikemaskini.`);
}

